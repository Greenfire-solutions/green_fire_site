{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/onboard",
      "destination": "/api/onboard"
    },
    {
      "source": "/activate",
      "destination": "/api/onboard?form=activation"
    },
    {
      "source": "/launch",
      "destination": "/launch/index.html"
    },
    {
      "source": "/blog",
      "destination": "/blog/index.html"
    },
    {
      "source": "/blog/:path*",
      "destination": "/blog/:path*/index.html"
    },
    {
      "source": "/p/:token",
      "destination": "/api/share?t=:token"
    },
    {
      "source": "/((?!api/)(?!assets/).*)",
      "destination": "/index.html"
    }
  ],
  "redirects": [
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "green-fire-site.vercel.app"
        }
      ],
      "destination": "https://greenfire.earth/:path",
      "permanent": true
    },
    {
      "source": "/:path((?!api/).*)",
      "has": [
        {
          "type": "host",
          "value": "www.greenfire.earth"
        }
      ],
      "destination": "https://greenfire.earth/:path",
      "permanent": true
    },
    {
      "source": "/packages",
      "destination": "/offerings/packages",
      "permanent": true
    },
    {
      "source": "/cinematic",
      "destination": "/offerings/cinematic",
      "permanent": true
    },
    {
      "source": "/studio",
      "destination": "/offerings/studio",
      "permanent": true
    },
    {
      "source": "/workshops",
      "destination": "/offerings/workshops",
      "permanent": true
    },
    {
      "source": "/utah-bolt",
      "destination": "/offerings/cinematic",
      "permanent": true
    },
    {
      "source": "/offerings/utah-bolt",
      "destination": "/offerings/cinematic",
      "permanent": true
    },
    {
      "source": "/program",
      "destination": "/how-it-works",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/blog/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ],
  "functions": {
    "api/onboard.ts": {
      "includeFiles": "src/data/startOffers.json"
    }
  }
}
